# 仅开放部署必需文件、项目文档及其资源；新增文件类型时需显式补充。
*
!*/

# 仓库规则、项目说明与部署入口。
!/.gitignore
!/.dockerignore
!/.env.example
!/AGENTS.md
!/README.md
!/Dockerfile
!/docker-compose.yaml
!/index.html
!/nginx.conf
!/package.json
!/package-lock.json
!/vite.config.js

# 构建所需的源码、运行图标、配置和资源生成脚本。
!/src/**/*.vue
!/src/**/*.js
!/src/**/*.css
!/src/assets/**/*.webp
!/config/*.js
!/scripts/*.mjs
!/deploy/*.conf

# 描述文档及页面预览图。
!/description/**/*.md
!/description/assets/screenshots/*.jpg
!/description/assets/screenshots/*.png
!/description/assets/screenshots/*.webp

# 本地依赖、产物、测试、编辑器和临时目录始终不参与提交。
node_modules/
/.vscode/
/.idea/
/tests/
/dist/
/dist-ssr/
/coverage/
/logs/

# PDF.js 资源由锁定依赖在开发和构建前生成，无需保留空目录。
/public/
