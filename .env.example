# Vite 服务和构建预览共用的代理目标，不进入浏览器构建产物。
# 使用 .env 或 .env.local，不需要模式专属配置。
REGISTRY_BACKEND_URL=http://127.0.0.1:23000

# Docker 部署的宿主机 HTTP 端口，外层 HTTPS 网关转发到此端口。
FRONTEND_PORT=23080
# registry-deploy 创建的网络；自定义 Compose 项目名时需同步修改。
REGISTRY_NETWORK=registry_registry
# 容器内后端地址：registry-deploy 的 backend 服务监听 8000。
BACKEND_UPSTREAM=backend:8000
